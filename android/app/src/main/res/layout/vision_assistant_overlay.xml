<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vision_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/vision_glass_sheet_bg"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="14dp"
    android:paddingRight="20dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/vision_glass_pill_chip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.brijesh.vision.VisionAssistantPulseView
            android:id="@+id/vision_overlay_orb"
            android:layout_width="46dp"
            android:layout_height="46dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vision_overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="VISION AI"
                android:textColor="#00D4FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vision_overlay_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening Assistant"
                android:textColor="#A7B2C5"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/vision_overlay_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vision_glass_pill_chip"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="Ready"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/vision_overlay_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="3dp"
        android:text="Tap Speak or say a command..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vision_overlay_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text=""
        android:textColor="#A7B2C5"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vision_overlay_mic_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.1"
            android:background="@drawable/vision_glass_cta_primary"
            android:text="Speak"
            android:textAllCaps="false"
            android:textColor="#050812"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/vision_overlay_open_app_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/vision_glass_cta_secondary"
            android:text="Full Assistant"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/vision_overlay_dismiss_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/vision_glass_cta_secondary"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#A7B2C5"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
